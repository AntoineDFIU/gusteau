# Gusteau server config (read by deploy/gusteau_server.py via systemd).
# Copy to gusteau.env next to gusteau_server.py.

GUSTEAU_PORT=8080

# mock | nebius | ollama
GUSTEAU_PROVIDER=ollama

# Ollama on a Mac on the same network (standard port 11434, OpenAI-compatible /v1 API).
# The Mac must listen on the network (OLLAMA_HOST=0.0.0.0, or the Ollama app's
# "Expose Ollama to the network" setting).
LLM_BASE_URL=http://macbook-pro-m5-max.local:11434/v1
LLM_MODEL=qwen3.6:35b-mlx

# A sleeping MacBook doesn't answer on 11434. Connecting to a service it
# advertises over Bonjour (file sharing 445, AirPlay 7000, SSH 22) wakes it
# ("Wake on Demand"). The server does that before each model request and
# keeps the Mac awake until the answer arrives. Remove to disable.
LLM_WAKE_PORTS=445,7000,22

# The ollama preset already turns off "thinking" so answers come back fast.
# Override only if you need to:
# LLM_EXTRA_BODY={"reasoning_effort":"none"}

# For NVIDIA Nemotron on Nebius Token Factory instead:
# GUSTEAU_PROVIDER=nebius
# LLM_API_KEY=your-token-factory-key
