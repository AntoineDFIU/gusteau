# ---------------------------------------------------------------
# Gusteau model configuration for `npm run dev`.
# Copy to .env.local and fill in. Leave GUSTEAU_PROVIDER=mock (or
# unset) to run the fully local mock demo.
#
# All of these are read SERVER-SIDE (vite.config.ts in dev,
# deploy/gusteau_server.py on the Raspberry Pi). The browser only
# learns the provider label and model names via /api/config.
# ---------------------------------------------------------------

# mock | nebius | ollama
GUSTEAU_PROVIDER=mock

# ── Ollama (e.g. a Mac on your network, standard port 11434) ──
# GUSTEAU_PROVIDER=ollama
# LLM_BASE_URL=http://macbook-pro-m5-max.local:11434/v1
# LLM_MODEL=qwen3.6:35b-mlx
# (The ollama preset turns off "thinking" automatically.)

# ── NVIDIA Nemotron on Nebius Token Factory ──
# GUSTEAU_PROVIDER=nebius
# LLM_API_KEY=your-token-factory-key
# LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Check the Token Factory catalog for exact model IDs:
# LLM_VISION_MODEL=nvidia/Nemotron-Nano-12B-v2-VL
# LLM_TEXT_MODEL=nvidia/Llama-3_3-Nemotron-Super-49B-v1_5
